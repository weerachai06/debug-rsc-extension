{
  "name": "debug-rsc-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build flight --target web --no-pack --out-dir ../src/wasm --out-name flight",
    "bindings": "cargo test --manifest-path flight/Cargo.toml",
    "check:bindings": "rm -rf src/bindings && npm run bindings && git diff --exit-code src/bindings && ! grep -rq bigint src/bindings",
    "dev": "npm run wasm && wxt",
    "build": "npm run wasm && wxt build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "preact": "11.1.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wxt": "0.21.5"
  }
}
